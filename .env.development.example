# Token Monitor developer mode environment variable
#
# General users do not need this file. This flag is intended only for local
# development, debugging, packaged exe reproduction tests, provider collection
# checks, Gemini parser checks, and dashboard state review.
#
# Do not put OAuth access tokens, refresh tokens, account emails, account IDs,
# credential file contents, or raw provider responses in environment variables.

# 0: normal app behavior
# 1: enable developer-only debug and verification views
TOKEN_MONITOR_DEV_MODE=0
