# Token Monitor developer mode environment variable
#
# General users do not need this file. This flag is intended only for local
# development on this local machine, provider collection checks, Gemini parser
# checks, packaged exe reproduction checks, and dashboard state review.
#
# Names, nicknames, and emails may be shown by the reviewed account-identification
# UI, but do not put personal data, OAuth tokens, provider-internal account IDs,
# credential file contents, or raw provider responses in environment variables.

# Copy this file to `.env` for local development. `.env` stays ignored by Git.
#
# 0: normal app behavior
# 1: enable developer-only debug and verification views
TOKEN_MONITOR_DEV_MODE=0
